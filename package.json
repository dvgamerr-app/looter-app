{
  "name": "looter-app",
  "description": "App to note game items, loot, and reminders, ensuring players never forget in-game progress.",
  "author": "Kananek T. <info.dvgamer@gmail.com>",
  "license": "MIT",
  "private": false,
  "version": "1.0.0",
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "typecheck": "bun run typecheck:renderer && bun run typecheck:main",
    "typecheck:renderer": "node node_modules/vue-tsc/bin/vue-tsc.js --noEmit -p tsconfig.app.json",
    "typecheck:main": "tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "vue": "^3.5.43",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "electron-builder-squirrel-windows": "26.17.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsonpath-plus": "^11.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vite-plugin-electron": "^1.1.2",
    "vue-tsc": "^3.3.12"
  },
  "main": "dist-electron/main.js",
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "electron"
  ]
}
